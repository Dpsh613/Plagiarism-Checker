SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
# Optional: use any SMTP relay instead of Gmail (e.g. Resend test mode).
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_your_resend_api_key
# SMTP_FROM=onboarding@resend.dev
# NOTE: Resend without a verified domain only delivers to your own account
# email. Launching to other users needs a verified domain (Resend) or a
# provider that allows single-address senders.
JWT_SECRET_KEY=your_secure_random_string
APP_ENV=development
# FRONTEND_URLS=http://localhost:5173,https://your-production-domain.com
# FRONTEND_URL=https://your-production-domain.com
# BACKEND_URL=https://api.your-production-domain.com
# COOKIE_SECURE=true
