JWT_SECRET_KEY=your_secure_random_string
APP_ENV=development
# FRONTEND_URLS=http://localhost:5173,https://your-production-domain.com
# FRONTEND_URL=https://your-production-domain.com
# BACKEND_URL=https://api.your-production-domain.com
# COOKIE_SECURE=true
# Concurrency / quotas (defaults shown)
# MAX_HEAVY_JOBS=2
# MAX_VECTORS_PER_USER=10000
# Data directory (Render Disk mount point when using a paid disk)
# CHECKMATE_DATA_DIR=/data
# Durable snapshots on ephemeral hosts (free tier): S3-compatible storage.
# Without these, backups are disabled and state lives on local disk only.
# SNAPSHOT_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# SNAPSHOT_REGION=auto
# SNAPSHOT_BUCKET=checkmate-data
# SNAPSHOT_ACCESS_KEY=your_key
# SNAPSHOT_SECRET_KEY=your_secret
# BACKUP_DEBOUNCE_SECONDS=120
